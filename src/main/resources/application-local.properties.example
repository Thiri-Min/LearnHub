# Copy this file to application-local.properties (same folder) and add your keys.
# application-local.properties is gitignored — never commit real API keys.
#
#   copy application-local.properties.example application-local.properties
#
# Then restart the app.

# OpenAI (https://platform.openai.com/api-keys)
app.ai.openai-api-key=sk-your-openai-key-here
app.ai.model=gpt-4o-mini

# Google Gemini (https://aistudio.google.com/apikey) — optional backup
# app.ai.gemini-api-key=your-gemini-key-here
# app.ai.gemini-model=gemini-2.5-flash
